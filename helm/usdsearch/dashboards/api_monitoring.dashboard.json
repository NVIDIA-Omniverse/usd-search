    {
      "id": 10,
      "type": "table",
      "title": "Current p99 latency by endpoint",
      "description": "Latest p99 per endpoint, sorted by endpoint name so rows stay put across refreshes. p50/p90/p99 over time are in the per-endpoint panels above.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, handler) (rate(omnideepsearch_restapi_http_request_duration_seconds_bucket{namespace=\"$namespace\", release_name=\"$omni_instance\", handler=~\"/v[23]/deepsearch/search|/v3/images|/images|/v3/deepsearch/vlm_validate/search_result\"}[$__rate_interval])))",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "handler": "Endpoint",
              "Value": "p99 latency"
            },
            "indexByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Endpoint",
            "desc": false
          }
        ]
