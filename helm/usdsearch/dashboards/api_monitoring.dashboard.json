          "editorMode": "code",
          "expr": "sum by (handler) (rate(omnideepsearch_restapi_http_requests_total{namespace=\"$namespace\", release_name=\"$omni_instance\", handler=~\"/v[23]/deepsearch/search|/v3/images|/images|/v3/deepsearch/vlm_validate/search_result\", status=~\"5..\"}[$__rate_interval]))",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "{{handler}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
