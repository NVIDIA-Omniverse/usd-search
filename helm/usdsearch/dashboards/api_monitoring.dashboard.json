    {
      "id": 6,
      "type": "timeseries",
      "title": "Search latency (p50 / p90 / p99)",
      "description": "Response-time percentiles for the search endpoint.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(omnideepsearch_restapi_http_request_duration_seconds_bucket{namespace=\"$namespace\", release_name=\"$omni_instance\", handler=~\"/v[23]/deepsearch/search\"}[$__rate_interval])))",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.9, sum by (le) (rate(omnideepsearch_restapi_http_request_duration_seconds_bucket{namespace=\"$namespace\", release_name=\"$omni_instance\", handler=~\"/v[23]/deepsearch/search\"}[$__rate_interval])))",
          "refId": "B",
          "instant": false,
          "range": true,
          "legendFormat": "p90"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(omnideepsearch_restapi_http_request_duration_seconds_bucket{namespace=\"$namespace\", release_name=\"$omni_instance\", handler=~\"/v[23]/deepsearch/search\"}[$__rate_interval])))",
          "refId": "C",
          "instant": false,
          "range": true,
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
